{
    "$schema": "./schema.json",
    "server": {
        "name": "",
        "domain": "",
        "nodeId": "",
        "rpc": {
            "port": 9527,
            "timeout": 30000
        },
        "monitor": {
            "port": 9528,
            "statsInterval": 60000
        },
        "webhook": {
            "port": 9530,
            "secret": "test-secret-local-dev",
            "updateScript": "/opt/zeromaps-rpc/auto-update.sh",
            "forwardToOtherNodes": true
        }
    },
    "utls": {
        "proxyPort": 8765,
        "concurrency": 20,
        "timeout": 10000,
        "enableKeepAlive": true,
        "enableAdaptiveConcurrency": false,
        "adaptiveConcurrency": {
            "adjustmentInterval": 30000,
            "minConcurrency": 5,
            "maxConcurrency": 300,
            "responseTimeThreshold": 2000,
            "successRateThreshold": 0.8,
            "note": "默认禁用 UTLSFetcher 内部调整，由 RpcServer 统一管理（避免冲突）"
        }
    },
    "ipv6": {
        "prefix": "",
        "start": 1001,
        "count": 100,
        "healthCheck": {
            "maxError403Count": 5,
            "minRequestsBeforeCheck": 20,
            "failureRateThreshold": 0.3,
            "responseTimeThreshold": 3000,
            "rateLimitThreshold": 0.2
        }
    },
    "logging": {
        "level": "info",
        "maxFileSize": 10485760,
        "maxFiles": 10
    },
    "performance": {
        "maxRequestLogs": 100,
        "healthCheckInterval": 300000
    },
    "dataValidation": {
        "minResponseSize": 50,
        "allowedContentTypes": [
            "image/",
            "application/octet-stream"
        ]
    },
    "dns": {
        "enabled": true,
        "ipPoolFile": "/opt/zeromaps-rpc/utls-proxy/ip-pools.json",
        "ipPoolUsageRate": 0.95,
        "probeInterval": 300000,
        "saveInterval": 300000,
        "health": {
            "consecutiveFailsThreshold": 3,
            "successRateThreshold": 0.5,
            "blacklistDuration": 600000,
            "minPoolSize": 2
        }
    },
    "p2p": {
        "enabled": false,
        "nodes": [
            "tile0.zeromaps.cn:9528",
            "tile3.zeromaps.cn:9528",
            "tile4.zeromaps.cn:9528",
            "tile5.zeromaps.cn:9528",
            "tile6.zeromaps.cn:9528",
            "tile12.zeromaps.cn:9528",
            "www.zeromaps.com.cn:9528"
        ],
        "syncInterval": 60000,
        "healthReportInterval": 60000,
        "reconnectDelay": 5000
    }
}